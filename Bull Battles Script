local function isEnemy(player)
    if player == lp then return false end
    local teams = game:GetService("Teams"):GetTeams()
    if #teams > 1 then
        if lp.Team == nil or player.Team == nil then return true end
        return lp.Team ~= player.Team
    end
    return true
end

