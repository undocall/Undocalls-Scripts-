local function addPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name
    page.Size = UDim2.new(1, -8, 1, -8)
    page.Position = UDim2.new(0, 4, 0, 4)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = COL.accent
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.Visible = false
    page.Parent = contentArea
    local pl = Instance.new("UIListLayout"); pl.Padding = UDim.new(0, 5); pl.Parent = page
    local pp = Instance.new("UIPadding"); pp.PaddingTop = UDim.new(0, 4); pp.PaddingBottom = UDim.new(0, 10); pp.PaddingLeft = UDim.new(0, 5); pp.PaddingRight = UDim.new(0, 5); pp.Parent = page
    pages[name] = page

    local sb = Instance.new("TextButton")
    sb.Name = name .. "Btn"
    sb.Size = UDim2.new(1, 0, 0, 34)
    sb.BackgroundColor3 = COL.sidebarItem
    sb.Text = name
    sb.TextColor3 = COL.textDim
    sb.Font = Enum.Font.GothamMedium
    sb.TextSize = 11
    sb.AutoButtonColor = false
    sb.Parent = sidebar
    local sbc = Instance.new("UICorner"); sbc.CornerRadius = UDim.new(0, 8); sbc.Parent = sb
    sideBtns[name] = {btn = sb}

    sb.MouseButton1Click:Connect(function()
        for pn, pg in pairs(pages) do pg.Visible = (pn == name) end
        for bn, bd in pairs(sideBtns) do
            if bn == name then
                bd.btn.BackgroundColor3 = COL.accent
                bd.btn.TextColor3 = COL.text
                bd.btn.Font = Enum.Font.GothamBold
            else
                bd.btn.BackgroundColor3 = COL.sidebarItem
                bd.btn.TextColor3 = COL.textDim
                bd.btn.Font = Enum.Font.GothamMedium
            end
        end
    end)
    return page
end

