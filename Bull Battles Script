-- ═══════════ INVISIBLE ═══════════
local invisibleEnabled = false
local invisibleParts = {}
local invisibleConnection = nil
local invisibleKeyConnection = nil

local function setupInvisibleParts()
    invisibleParts = {}
    local char = lp.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency == 0 then
            table.insert(invisibleParts, d)
        end
    end
end

local function startInvisible()
    if invisibleEnabled then return end
    invisibleEnabled = true

    -- Disable fly to avoid HRP conflict
    if flyV3Active then stopFlyV3() end

    setupInvisibleParts()
    for _, part in ipairs(invisibleParts) do
        pcall(function() part.Transparency = 0.5 end)
    end

    if not invisibleConnection then
        invisibleConnection = RunService.Heartbeat:Connect(function()
            if not invisibleEnabled then return end
            local c = lp.Character
            if not c then return end
            local h = c:FindFirstChildOfClass("Humanoid")
            local r = c:FindFirstChild("HumanoidRootPart")
            if not h or not r then return end

            pcall(function()
                local origCF = r.CFrame
                local origOffset = h.CameraOffset
                local downCF = origCF * CFrame.new(0, -200000, 0)
                r.CFrame = downCF
                h.CameraOffset = downCF:ToObjectSpace(CFrame.new(origCF.Position)).Position
                RunService.RenderStepped:Wait()
                r.CFrame = origCF
                h.CameraOffset = origOffset
            end)
        end)
    end
end

local function stopInvisible()
    invisibleEnabled = false
    for _, part in ipairs(invisibleParts) do
        pcall(function() part.Transparency = 0 end)
    end
    invisibleParts = {}
    if invisibleConnection then
        invisibleConnection:Disconnect()
        invisibleConnection = nil
    end
    local char = lp.Character
    if char then
        local h = char:FindFirstChildOfClass("Humanoid")
        if h then
            pcall(function() h.CameraOffset = Vector3.zero end)
        end
    end
end

local function toggleInvisible()
    if invisibleEnabled then
        stopInvisible()
        notify("Invisible", "OFF", 2)
    else
        startInvisible()
        notify("Invisible", "ON", 2)
    end
end

