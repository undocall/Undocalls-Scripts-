local function executeACR(char, hum, hrp)
    if not (char and hum and hrp) then return end
    pcall(function()
        hrp.Anchored = true
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hum.PlatformStand = false
        hum.Sit = false
        local currentPos = hrp.Position
        local lookVector = hrp.CFrame.LookVector
        local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
        if flatLook.Magnitude < 0.1 then flatLook = Vector3.new(0, 0, -1) end
        local newPos = currentPos + Vector3.new(0, 2.5, 0)
        hrp.CFrame = CFrame.new(newPos, newPos + flatLook)
        hum:ChangeState(Enum.HumanoidStateType.Freefall)
        task.wait(0.05)
        hrp.Anchored = false
        hum.Jump = true
    end)
end

local function toggleAntiFling(enabled)
    noFallEnabled = enabled
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if enabled then
        flingBtn.Text = "A-Fling  ON"
        flingBtn.TextColor3 = COL.green
        executeACR(char, hum, hrp)
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        end)
        if not noFallConnection then
            noFallConnection = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local c = lp.Character
                    if not c then return end
                    local r = c:FindFirstChild("HumanoidRootPart")
                    local h = c:FindFirstChildOfClass("Humanoid")
                    if r and h then
                        local lv = r.AssemblyLinearVelocity
                        local av = r.AssemblyAngularVelocity
                        local hs = Vector3.new(lv.X, 0, lv.Z).Magnitude
                        if hs > 150 or av.Magnitude > 75 then executeACR(c, h, r) end
                        if h.PlatformStand then h.PlatformStand = false; h.Jump = true end
                    end
                end)
            end)
        end
    else
        flingBtn.Text = "A-Fling  OFF"
        flingBtn.TextColor3 = COL.red
        if noFallConnection then noFallConnection:Disconnect(); noFallConnection = nil end
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end)
        executeACR(char, hum, hrp)
    end
end

