-- Standard Kill Aura
RunService.Heartbeat:Connect(function()
    if not killAuraOn then return end
    if not keyVerified then return end
    if not FlingRE then return end
    local now = tick()
    if now - lastAuraHit < auraDelay then return end
    lastAuraHit = now

    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local nearest, nearestDist = nil, auraRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local eHum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and eHum and eHum.Health > 0 then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearest = p
                    nearestDist = dist
                end
            end
        end
    end
    if nearest then pcall(function() FlingRE:FireServer(nearest) end) end
end)

-- OP God Spawn loop
RunService.Heartbeat:Connect(function()
    if not opGodSpawnOn then return end
    if not keyVerified then return end
    if not FlingRE then return end

    local char = lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hrp and hum) then return end
    if hum.Health <= 0 then return end

    -- Skip arena logic while invisible (HRP is being moved by invisible loop)
    if invisibleEnabled then return end

    if hum.Sit then
        hum.Sit = false
        hum.SeatPart = nil
    end
    stripMount(char)

    local distFromArena = (hrp.Position - ARENA_POS).Magnitude
    if distFromArena > 150 then
        pcall(function()
            hum.Sit = false
            hum.SeatPart = nil
            hrp.Anchored = true
            hrp.CFrame = CFrame.new(ARENA_TELEPORT)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            task.wait(0.1)
            hrp.Anchored = false
        end)
    end

    local now = tick()
    if now - lastOpAuraHit < auraDelay then return end
    lastOpAuraHit = now

    local nearest, nearestDist = nil, opAuraRange
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local eHum = p.Character:FindFirstChildOfClass("Humanoid")
            if root and eHum and eHum.Health > 0 then
                local dist = (hrp.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearest = p
                    nearestDist = dist
                end
            end
        end
    end
    if nearest then
        pcall(function() FlingRE:FireServer(nearest) end)
    end
end)

-- Target Lock
RunService.Heartbeat:Connect(function()
    if not targetLockOn then return end
    if invisibleEnabled then return end
    if not target or not target.Parent then
        local storedName = target and target.Name
        if storedName then
            local refound = smartFind(storedName)
            if refound then target = refound end
        end
        return
    end
    local tChar = target.Character
    if not tChar then return end
    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
    if not tRoot then return end
    local myChar = lp.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end
    myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 2, 3)
end)

-- Respawn handling
lp.CharacterAdded:Connect(function(char)
    task.wait(0.7)
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.PlatformStand = false
            enableAllHumanoidStates(hum)
        end
        if char:FindFirstChild("Animate") then
            char.Animate.Disabled = false
        end
    end)
    flyV3Active = false
    flyV3UpHeld = false
    flyV3DownHeld = false

    -- Reset invisible state on respawn (safest — user must re-toggle)
    if invisibleEnabled then
        invisibleEnabled = false
        invisibleParts = {}
        if invisibleConnection then
            invisibleConnection:Disconnect()
            invisibleConnection = nil
        end
    end

    if killAuraOn and keyVerified and not spawningDebounce then
        spawningDebounce = true
        task.spawn(function()
            task.wait(0.5)
            local root = char:FindFirstChild("HumanoidRootPart")
            if root and root.Position.Z < LOBBY_MAX_Z then
                pcall(function()
                    if not SpawnerRE then findRemotes() end
                    if SpawnerRE then SpawnerRE:FireServer() end
                end)
            end
            task.wait(2)
